(defwidget activate-linux []
  (box
    :orientation "v"
    :halign "start"
    :valign "start"
    (label :xalign 0 :markup "<span font_size=\"large\">Activate Linux</span>")
    (label :xalign 0 :text "Go to Settings to activate Linux")))

(defwindow activate-linux
  :monitor 0
  :stacking "fg"
  :geometry (geometry :x "8px" :y "32px" :width "250px" :anchor "bottom right")
  (activate-linux))

(defvar battery_enabled false)
(defvar memory_enabled false)
(defvar cpu_usage_enabled false)


(defwidget configure-waybar []
  (box :orientation "vertical"
    :class "checkbox-container"
    (box :class "battery"
      (checkbox
        :checked battery_enabled
        :onchecked "eww update battery_enabled=true"
        :onunchecked "eww update battery_enabled=false"
      (label :text "Battery"))
    )
    (box :class "memory"
      (checkbox
        :checked memory_enabled
        :onchecked "eww update memory_enabled=true"
        :onunchecked "eww update memory_enabled=false"
      (label :text "Memory"))
    )
    (box :class "cpu-usage"
      (checkbox
        :checked cpu_usage_enabled
        :onchecked "eww update cpu_usage_enabled=true"
        :onunchecked "eww update cpu_usage_enabled=false"
      (label :text "CPU usage"))
    )
  )
)

(defwindow configure-waybar
  :monitor 0
  :geometry (geometry 
  :x "30px"
  :y "30px"
  :width "500px"
  :height "300px"
  :anchor "top right")

  :stacking "fg"
  :wm-ingore false
  (configure-waybar))
