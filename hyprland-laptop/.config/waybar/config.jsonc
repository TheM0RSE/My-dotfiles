{
  "layer": "top",
  "modules-left": ["hyprland/workspaces", "group/left"],
  "modules-center": [],
  "modules-right": ["group/status"],
  "hyprland/window": {
    "max-length": 70
  },
  "clock": {
    "interval": 60,
    "tooltip": true,
    "format": "{:%d.%m.%y %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "iso8601": true,
      "format": {
        "months": "<span color='#EBEBD3'><b>{}</b></span>",
        "days": "<span color='#EBEBD3'><b>{}</b></span>",
        "weeks": "<span color='#DA4167'><b>{}</b></span>",
        "weekdays": "<span color='#F4D35E'><b>{}</b></span>",
        "today": "<span color='#F78764'><b><u>{}</u></b></span>"
      },
    }

  },
  "bluetooth": {
    "format": "",
    "format-disabled": "", // an empty format will hide the module
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  "cpu": {
    "interval": 30,
    "format": " {}%",
    "max-length": 10,
  },
  "memory": {
    "interval": 30,
    "format": " {}%",
    "max-length": 10
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": " {ipaddr}",
    "format-disconnected": "", //An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
  },
  "tray": {
    "icon-size": 20,
    "spacing": 10,
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title} - {artist}",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "max-length": 30,
    // "ignored-players": ["firefox"]
  },
  "battery": {
    "battery": "BAT0",
    "interval": 30,
    "format": "{icon} {capacity}%",
    "format-icons": {
        "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    },
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
        "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
        "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "phone-muted": "",
        "portable": "",
        "car": "",
        "default": ["", ""]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout"
  },

  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "mpris",
      "bluetooth",
      "pulseaudio",
      "cpu",
      "memory",
      "battery",
      "tray",
      "custom/power"
    ]
  },

  "group/left": {
    "orientation": "horizontal",
    "modules": [
      "clock",
      "hyprland/window",
    ]
  },
  "ipc": true
}
